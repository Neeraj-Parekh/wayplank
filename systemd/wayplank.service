[Unit]
Description=Wayplank dock (Plank rebuild with Shell bridge tracking)
After=gnome-session.target
PartOf=gnome-session.target

[Service]
Type=simple
# Proven configuration: run as an XWayland client (renders reliably),
# track native apps through the wayplank-bridge Shell extension.
Environment=GDK_BACKEND=x11
Environment=DISPLAY=:0
ExecStart=/usr/bin/wayplank
Restart=always
RestartSec=3

[Install]
WantedBy=gnome-session.target
