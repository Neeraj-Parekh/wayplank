prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@
pkgdatadir=@datarootdir@/plank

Name: Wayplank
Description: Generic dock library of Wayplank
Version: @PACKAGE_VERSION@
Requires: cairo gee-0.8 glib-2.0 gio-2.0 gobject-2.0 gdk-3.0 gdk-pixbuf-2.0 gtk+-3.0 libbamf3
Libs: -L${libdir} -lwayplank
Cflags: -I${includedir}/plank
