Build-Depends: debhelper-compat (= 13), valac (>= 0.34),
 libgtk-3-dev, libwnck-3-dev, libbamf3-dev, libgee-0.8-dev,
 libgnome-menu-3-dev, libxfixes-dev, libxi-dev, libdbusmenu-glib-dev,
 libdbusmenu-gtk3-dev, autoconf, automake, libtool, gettext, autopoint,
